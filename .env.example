# =============================================================================
# FreeDownload — environment specification (contract §56)
#
# Copy to `.env` for local development:   cp .env.example .env
# NEVER commit `.env`. NEVER put real production secrets in this file.
# Backend variables are validated by backend/src/server/config.ts — the process
# refuses to boot on invalid configuration.
# =============================================================================

# --- core -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=backend-api
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Comma-separated CORS allowlist (Vercel previews: add https://*.vercel.app)
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# --- data (Phase 2) ---------------------------------------------------------
DATABASE_URL=postgres://freedownload:freedownload_dev@localhost:5432/freedownload
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=fd

# --- auth (Phase 2) — generate: openssl rand -base64 48 ---------------------
# SESSION_SECRET and COOKIE_SECRET are REQUIRED in production (boot fails
# without them); both are optional in development. They stay commented out so
# a fresh `cp .env.example .env` boots locally — note an empty value (KEY=)
# does NOT count as unset, the 32-char minimum would reject it.
# SESSION_SECRET=
# COOKIE_SECRET=
SESSION_TTL_MIN=10080
# Admin sessions live until explicit logout, capped at 30 days (§75).
ADMIN_SESSION_TTL_MIN=43200
VERIFY_TOKEN_TTL_H=24
RESET_TOKEN_TTL_MIN=30
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Cookie policy: production defaults to SameSite=None + Secure (Vercel → VPS);
# development defaults to Lax. Override only if you know why.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# --- rate limits (Phase 2) — enforced by the Redis-backed limiter ----------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
# Tighter per-route limit for /api/v1/auth/* and /api/v1/me/password
AUTH_RATE_LIMIT_MAX=10

# --- admin login (seed + direct .env credential check) ----------------------
# WARNING: change ADMIN_PASSWORD outside local dev — the committed default is
# public, and the seed creates the owner account whenever both are set.
ADMIN_EMAIL=admin@freedownload.com
ADMIN_PASSWORD=220128
# Admin 2FA gate — leave false to sign in with email+password only (for now).
ADMIN_MFA_REQUIRED=false

# --- storage (Phase 4) ------------------------------------------------------
# local: filesystem driver for development (signed URL → GET /api/v1/files/*)
# r2:    Cloudflare R2 via SigV4 (REQUIRED with R2_* credentials in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
SIGNED_URL_TTL_SEC=300
R2_RETENTION_DAYS=7

# --- media engine (Phase 4) ---------------------------------------------------
# Which JobRunner the worker drives: `pipeline` (real yt-dlp/ffmpeg) or
# `placeholder` (Phase 3 test stand-in). Production requires `pipeline`.
# (SOURCE_TIMEOUT_MS, ANALYZE_CACHE_TTL_SEC and MAX_FILE_SIZE_MB are defined
# in the queue/limits sections below.)
WORKER_RUNNER=pipeline
# Single-service mode: API process also runs the workers (Render free tier).
WORKER_IN_API=false
# Binary locations — leave unset to use PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# DANGER: lets SSRF guards accept private/loopback addresses (fixture servers
# in tests only). Production config validation refuses to boot with this set.
# SSRF_ALLOW_PRIVATE=true

# --- queue / workers (Phase 3) ----------------------------------------------
BULLMQ_PREFIX=fd
WORKER_CONCURRENCY=4
# Whole-run deadline per attempt: long 4K videos need well over 5 minutes.
JOB_TIMEOUT_MS=1800000
SOURCE_TIMEOUT_MS=60000
QUEUE_RETRY_LIMIT=3
SHUTDOWN_GRACE_MS=20000
LEASE_TTL_MS=30000
CLEANUP_INTERVAL_MIN=15

# --- limits (DB overrides these defaults, Phase 7) --------------------------
MAX_FILE_SIZE_MB=512
ANONYMOUS_DAILY_LIMIT=5
FREE_DAILY_LIMIT=25
PRO_DAILY_LIMIT=200
ANON_CONCURRENCY=1
USER_CONCURRENCY=2
# API-key requests allowed per key per UTC hour (plan.limits.apiPerHour wins)
API_KEY_HOURLY_LIMIT=60
ANALYZE_CACHE_TTL_SEC=300

# --- Cloudflare / edge ------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CF_API_TOKEN=

# --- keepalive (Render free tier) ------------------------------------------
# Render sleeps free web services after 15 idle minutes. With this on, the
# API pings its own /health every SELF_PING_INTERVAL_MIN (default 10) so
# quiet stretches never trigger a cold start. Needs SELF_PING_URL, or it
# uses Render's injected RENDER_EXTERNAL_URL automatically.
# NOTE: this PREVENTS sleep while running - it cannot wake an already
# sleeping service. Always-warm burns ~720 of 750 free hours/month.
SELF_PING_ENABLED=false
# SELF_PING_URL=https://<your-service>.onrender.com/health
SELF_PING_INTERVAL_MIN=10

# --- fallback downloader (cobalt, self-hosted) ---------------------------------
# When set, yt-dlp failures fall back to this cobalt instance instead of
# failing the job. Leave unset for yt-dlp only. Host your own instance
# (one docker command) - never use someone else's public instance.
# COBALT_API_URL=https://cobalt.internal.example
# COBALT_API_KEY=

# --- observability ----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# --- billing (Phase 7) ------------------------------------------------------
# `none` → checkout endpoints answer 503 (Billing is not configured).
# `stripe` requires both secrets; production refuses to boot without them.
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_SECRET=
# Stripe webhook signing secret (whsec_…); also used by the test suite.
PAYMENT_WEBHOOK_SECRET=

# --- email / SMTP (Phase 2) -------------------------------------------------
# `console` logs mail (development); `smtp` is wired up when outbound email
# ships — production refuses to send rather than silently dropping mail.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FreeDownload <no-reply@example.com>"

# --- frontend (Vercel project settings / .env.local) ------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development
# Idempotency-Key replay window (hours)
IDEMPOTENCY_TTL_H=24
# Job creation limit (per IP, per window)
DOWNLOAD_RATE_LIMIT_MAX=60
