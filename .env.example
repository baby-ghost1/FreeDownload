# =============================================================================
# FreeDownload — environment specification (contract §56)
#
# Copy to `.env` for local development:   cp .env.example .env
# NEVER commit `.env`. NEVER put real production secrets in this file.
# Backend variables are validated by src/server/config.ts — the process
# refuses to boot on invalid configuration.
# =============================================================================

# --- core -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=backend-api
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Comma-separated CORS allowlist (Vercel previews: add https://*.vercel.app)
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# --- data (Phase 2) ---------------------------------------------------------
DATABASE_URL=postgres://freedownload:freedownload_dev@localhost:5432/freedownload
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=fd

# --- auth (Phase 2) — generate: openssl rand -base64 48 ---------------------
# SESSION_SECRET and COOKIE_SECRET are REQUIRED in production (boot fails
# without them); both are optional in development.
SESSION_SECRET=
COOKIE_SECRET=
JWT_SECRET=
SESSION_TTL_MIN=10080
VERIFY_TOKEN_TTL_H=24
RESET_TOKEN_TTL_MIN=30
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Cookie policy: production defaults to SameSite=None + Secure (Vercel → VPS);
# development defaults to Lax. Override only if you know why.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# --- rate limits (Phase 2) — enforced by the Redis-backed limiter ----------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
# Tighter per-route limit for /api/v1/auth/* and /api/v1/me/password
AUTH_RATE_LIMIT_MAX=10

# --- seed (npm run db:seed) — creates the owner admin account ---------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- storage (Phase 4) ------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
SIGNED_URL_TTL_SEC=300
R2_RETENTION_DAYS=7

# --- queue / workers (Phase 3) ----------------------------------------------
BULLMQ_PREFIX=fd
WORKER_CONCURRENCY=4
MAX_CONCURRENCY=4
JOB_TIMEOUT_MS=300000
SOURCE_TIMEOUT_MS=60000
SOURCE_CONCURRENCY=2
QUEUE_RETRY_LIMIT=3
SHUTDOWN_GRACE_MS=20000
LEASE_TTL_MS=30000
CLEANUP_INTERVAL_MIN=15

# --- limits (DB overrides these defaults, Phase 7) --------------------------
MAX_FILE_SIZE_MB=512
ANONYMOUS_DAILY_LIMIT=5
FREE_DAILY_LIMIT=25
PRO_DAILY_LIMIT=200
ANON_CONCURRENCY=1
USER_CONCURRENCY=2
ANALYZE_CACHE_TTL_SEC=300

# --- Cloudflare / edge ------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CF_API_TOKEN=

# --- observability ----------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# --- billing (Phase 7) ------------------------------------------------------
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- email / SMTP (Phase 2) -------------------------------------------------
# `console` logs mail (development); `smtp` is wired up when outbound email
# ships — production refuses to send rather than silently dropping mail.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FreeDownload <no-reply@example.com>"

# --- frontend (Vercel project settings / .env.local) ------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development
# Idempotency-Key replay window (hours)
IDEMPOTENCY_TTL_H=24
# Job creation limit (per IP, per window)
DOWNLOAD_RATE_LIMIT_MAX=60
