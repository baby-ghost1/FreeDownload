{
  "name": "freedownload",
  "version": "0.1.0",
  "private": true,
  "description": "Video downloader for Facebook, Instagram, YouTube, TikTok, Snapchat, X and more - production-grade media download and processing platform",
  "license": "UNLICENSED",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run e2e",
    "load": "k6 run load/catalog.js && k6 run load/auth.js && k6 run load/downloads.js && k6 run load/api-quota.js",
    "load:site": "k6 run load/site.js",
    "load:site:node": "node load/site-node.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @freedownload/backend",
    "db:migrate": "npm run db:migrate --workspace @freedownload/backend",
    "db:seed": "npm run db:seed --workspace @freedownload/backend",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.6"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
